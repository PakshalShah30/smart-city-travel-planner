# Postgres with the PostGIS extension available.
# Neon: https://neon.tech  ·  Supabase: https://supabase.com
# Confirm PostGIS is enabled on your plan before committing to one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The same database without the connection pooler (on Neon, the host without
# `-pooler`). db:migrate and db:setup use it, because schema changes need to
# hold one connection throughout. Optional: falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Optimizer service (Phase 3). Left unset, the app falls back to the built-in greedy solver.
OPTIMIZER_URL=""

# Google Places, used only to enrich the top few hundred POIs (Phase 2).
# Set a hard billing cap and a budget alert before the first call.
GOOGLE_PLACES_API_KEY=""

# Map tiles (Phase 4).
NEXT_PUBLIC_MAPTILER_KEY=""
