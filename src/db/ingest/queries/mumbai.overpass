[out:json][timeout:180];
// POI extract for Mumbai. Settings must be the first statement, so the
// explanation lives below it rather than above.
//
// Bounding box is (south, west, north, east) and covers the island city plus
// the western suburbs as far as Borivali, where Sanjay Gandhi National Park is.
//
// "out center tags" is load-bearing: most real attractions are mapped as ways
// or relations, not nodes, so without "center" they come back with no
// coordinates and the extract looks empty of anything worth visiting.
(
  nwr["tourism"~"^(attraction|museum|gallery|artwork|viewpoint|zoo|theme_park|aquarium)$"](18.88,72.77,19.28,72.99);
  nwr["historic"](18.88,72.77,19.28,72.99);
  nwr["leisure"~"^(park|garden|nature_reserve)$"](18.88,72.77,19.28,72.99);
  nwr["amenity"~"^(place_of_worship|marketplace|theatre|arts_centre)$"](18.88,72.77,19.28,72.99);
  nwr["natural"="beach"](18.88,72.77,19.28,72.99);
);
out center tags;
